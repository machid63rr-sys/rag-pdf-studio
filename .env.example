# このファイルを .env にコピーして編集する(docker compose が自動で読み込む)。
# DB_PASSWORD 以外は省略可能で、省略時は下記の値になる。
#
# 初回だけは、インターネットへの接続が必要（イメージのビルドと、Ollamaのモデル約10GBの取得）。
# 取得したモデルは名前付きボリューム(ollama-data)に残り、2回目以降はオフラインで起動できる。
# 注意: `docker compose down -v` はボリュームも消すため、モデルの再取得が必要になる
#       （登録したマニュアルのデータベース(pgdata)も消える）。止めるだけなら `docker compose down`。

# --- 必須 ---------------------------------------------------------------------

# データベースのパスワード（任意の値。未設定だと docker compose が起動しない）。
# 最初の起動で決まり、あとから変えてもデータベース側には反映されない（変える場合はボリュームの作り直しが必要）
DB_PASSWORD=

# --- 画面（app）---------------------------------------------------------------

# ブラウザで開くポート番号(http://localhost:8090)
HOST_PORT=8090

# 接続を受け付けるアドレス。
#   127.0.0.1 : このPCからのみ(既定)
#   0.0.0.0   : 同じネットワークの他のPCからも接続できる。認証機能は無いため、信頼できるネットワークでのみ使うこと。
#               ただし、他のPCからのhttp://IPアドレス のアクセスでは、ブラウザの仕様でフォルダへの直接出力が使えない
BIND_ADDR=127.0.0.1

# 受け付けるMarkdown・HTMLの最大サイズ(バイト)。画像は、文書に含めて送るため、そのサイズ(元の約1.3倍)も含む。既定は30MB
MAX_MARKDOWN_BYTES=31457280

# PDF生成のタイムアウト(ミリ秒)。既定は60秒
PDF_TIMEOUT_MS=60000

# --- OCR・RAG（ocr-rag）-------------------------------------------------------

# Ollamaのイメージのバージョン。既定は 0.32.5（動作を確認した版）。
# 新しいモデル（例: qwen3.8:27b は 0.32.12 以上）は、新しい版でないと取得できず、
# "the model you are attempting to pull requires a newer version of ollama" で ollama-init が失敗する。
# その場合は、行頭の「#」を外して版を上げ、`docker compose up -d` を実行する（ollamaコンテナが作り直される）
# OLLAMA_VERSION=0.32.15

# Ollamaのモデル。変えた場合、次の `docker compose up -d` で新しいモデルが自動で取得される
# （取得済みのモデルは取得し直さない。古いモデルを消す場合は、ollamaコンテナで `ollama rm <モデル名>`）。
# 埋め込みモデルを変えると、ベクトルの次元が合わなくなる場合がある（bge-m3は1024次元。database/schema.sql参照）
EMBEDDING_MODEL=bge-m3
# 比較用のOCR（OCRの主文を、別モデルで検算するために使う）
OCR_MODEL=glm-ocr
# OCRの主文を読むvision LLM
OCR_VISION_MODEL=qwen3.5:9b
# チャット（④）の回答を作るモデル。省略すると、OCRの主文を読むモデル（OCR_VISION_MODEL）と同じになる
# （同じモデルなら、モデルを1つ多く取得・常駐させずに済む）。別のモデルにする場合は、行頭の「#」を外す
# CHAT_MODEL=qwen3.5:9b

# vision LLM・補正1回あたりのタイムアウト(秒)。大きいモデルに替えて、1ページの生成がこれを超える場合に延ばす
OCR_VISION_TIMEOUT_SECONDS=120

# アップロード(PDF・Markdown)の最大サイズ(バイト)。既定は100MB
MAX_UPLOAD_BYTES=104857600
# 画面のサーバがocr-ragへ中継するアップロードの上限(バイト)。既定は110MB。
# MAX_UPLOAD_BYTES を上げる場合は、これも、それより10MB程度大きい値に上げる
RAG_MAX_UPLOAD_BYTES=115343360

# Ollamaがモデルをメモリに保持する時間。-1は保持し続ける（モデルの入れ替わりによる再ロード待ちを避ける）。
# メモリが少ない環境では 5m などにする
OLLAMA_KEEP_ALIVE=-1

# --- GPU ----------------------------------------------------------------------

# NVIDIA GPUがある場合は、次の行の「#」を外す。`docker compose up -d` だけで、OllamaにGPUが割り当てられる
# （OCRが大幅に速くなる）。GPUが無い環境では、外さないこと（ollamaが起動に失敗する）。
# 前提: NVIDIAドライバと NVIDIA Container Toolkit がホストに入っていること。
# 区切りはLinux/macOSが「:」、Windowsが「;」。
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
