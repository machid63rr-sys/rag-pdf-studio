{
  "name": "rag-pdf-studio-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PDF・Markdown・HTMLを扱う画面とPDF生成のサーバ(MD/HTML→PDF、PDF→OCR→MD、RAG登録・確認)。OCR・RAGはocr-rag(Python)へ中継する",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-assets.mjs",
    "build": "npm run build:client && npm run build:server",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lowlight": "^3.3.0",
    "mdast-util-to-string": "^4.0.0",
    "parse5": "^8.0.1",
    "puppeteer-core": "^25.12.0",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@mdxeditor/editor": "4.3.1",
    "@types/express": "^5.0.6",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.1.1",
    "lexical": "^0.48.0",
    "mermaid": "^12.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
